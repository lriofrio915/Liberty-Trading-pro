      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst name     = body.name     || 'amigo';\nconst phone    = body.phone    || '';\nconst plan     = body.plan     || 'MENSUAL';\nconst planLabel = body.planLabel || (plan === 'ANUAL' ? 'Club Anual ($649/año)' : 'Club Mensual ($79/mes)');\n\nconst planCtx = plan === 'ANUAL'\n  ? 'Vi que te interesa el Club Anual — la mejor opción si ya decidiste que el trading es tu camino. '\n  : 'Vi que te interesa el Club Mensual — perfecto para empezar sin compromisos. ';\n\nconst mensaje =\n  `¡Hola ${name}! 👋 Soy Vinces, el asistente del Club Liberty Trading.\\n\\n` +\n  `${planCtx}` +\n  `Luis me entrenó para orientar a personas que quieren aprender a invertir o hacer trading profesional.\\n\\n` +\n  `¿Me permites hacerte unas preguntas rápidas para asegurarme de que el club es lo que necesitas? 🎯`;\n\nreturn [{ json: { phone, name, plan, planLabel, mensaje } }];"
      },
