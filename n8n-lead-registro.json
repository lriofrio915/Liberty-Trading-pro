        "jsCode": "const body = $('Webhook — Formulario Unirse').first().json.body || $('Webhook — Formulario Unirse').first().json;\n\nconst name     = body.name     || 'sin nombre';\nconst phone    = body.phone    || 'sin teléfono';\nconst email    = body.email    || 'no proporcionado';\nconst planLabel = body.planLabel || 'Club Mensual ($79/mes)';\n\nconst msg =\n  `📥 *Nuevo lead desde el formulario web*\\n\\n` +\n  `👤 *Nombre:* ${name}\\n` +\n  `📱 *WhatsApp:* +${phone}\\n` +\n  `📧 *Email:* ${email}\\n` +\n  `🎯 *Plan de interés:* ${planLabel}\\n\\n` +\n  `_Vinces ya le escribió. Puedes hacer seguimiento directo._`;\n\nreturn [{ json: { msg } }];"
