    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\n\nconst name      = body.name      || 'amigo';\nconst phone     = String(body.phone || '').replace(/[^0-9]/g, '');\nconst plan      = body.plan      || 'MENSUAL';\nconst planLabel = body.planLabel || (plan === 'ANUAL' ? 'Club Anual ($649/año)' : 'Club Mensual ($79/mes)');\nconst email     = body.email     || 'no proporcionado';\n\nconst planCtx = plan === 'ANUAL'\n  ? 'Vi que te interesa el Club Anual — la mejor opción si ya decidiste que el trading es tu camino. '\n  : 'Vi que te interesa el Club Mensual — perfecto para empezar sin compromisos. ';\n\nconst mensajeLead =\n  `¡Hola ${name}! 👋 Soy Vinces, el asistente del Club Liberty Trading.\\n\\n` +\n  `${planCtx}` +\n  `Luis me entrenó para orientar a personas que quieren aprender a invertir o hacer trading profesional.\\n\\n` +\n  `¿Me permites hacerte unas preguntas rápidas para asegurarme de que el club es lo que necesitas? 🎯`;\n\nconst mensajeLuis =\n  `📥 *Nuevo lead desde el formulario web*\\n\\n` +\n  `👤 *Nombre:* ${name}\\n` +\n  `📱 *WhatsApp:* +${phone}\\n` +\n  `📧 *Email:* ${email}\\n` +\n  `🎯 *Plan de interés:* ${planLabel}\\n\\n` +\n  `_Vinces le escribirá en breve para iniciar la conversación._`;\n\nreturn [{\n  json: {\n    phone,\n    name,\n    plan,\n    planLabel,\n    email,\n    mensajeLead,\n    mensajeLuis\n  }\n}];"
      },
      "id": "node-build-msg",
      "name": "Extraer datos y construir mensajes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
