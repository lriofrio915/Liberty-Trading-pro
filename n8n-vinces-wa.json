{
  "name": "Vinces AI - WhatsApp Lead Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vinces-wa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Evolution API Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }"
      },
      "id": "node-respond",
      "name": "Responder 200 a Evolution",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-fromme",
              "leftValue": "={{ $json.body.data.key.fromMe }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "cond-event",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "messages",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-filter",
      "name": "Filtrar mensajes entrantes",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst data = body?.data;\n\nif (!data) return [{ json: { skip: true } }];\n\nconst msg = data.message || {};\nconst text =\n  msg.conversation ||\n  msg.extendedTextMessage?.text ||\n  msg.imageMessage?.caption ||\n  '';\n\nconst jid = data.key?.remoteJid || '';\n\n// Ignorar grupos, estado y mensajes vacíos\nif (!text.trim() || jid.includes('@g.us') || jid.includes('status@broadcast')) {\n  return [{ json: { skip: true } }];\n}\n\nreturn [{\n  json: {\n    phone: jid,\n    message: text.trim(),\n    pushName: data.pushName || null,\n    skip: false\n  }\n}];"
      },
      "id": "node-extract",
      "name": "Extraer datos del mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-valid",
      "name": "Mensaje valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://libertytrading.pro/api/vinces-wa",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "pushName",
              "value": "={{ $json.pushName }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-vinces-api",
      "name": "Vinces API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst extractNode = $('Extraer datos del mensaje').first().json;\nconst phone = extractNode.phone;\n\n// Limpiar número\nconst number = phone\n  .replace('@s.whatsapp.net', '')\n  .replace('@c.us', '')\n  .trim();\n\nconst messages = response.messages || [];\n\nif (messages.length === 0) return [];\n\n// Un item por mensaje, con delay creciente para que lleguen en orden\nreturn messages.map((text, i) => ({\n  json: {\n    number,\n    text,\n    delay: i * 3000\n  }\n}));"
      },
      "id": "node-prepare",
      "name": "Preparar respuestas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://EVOLUTION_API_URL/message/sendText/NOMBRE_INSTANCIA",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "TU_EVOLUTION_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.text, delay: $json.delay }) }}",
        "options": {}
      },
      "id": "node-send-wa",
      "name": "Enviar mensaje WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 200]
    }
  ],
  "connections": {
    "Evolution API Webhook": {
      "main": [
