# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Shared secret between Next.js (Vercel) and this service
LIBERTY_INTERNAL_TOKEN=<generate: uuidgen or python -c "import uuid; print(uuid.uuid4())">

# Fernet key for encrypting MT5 auth tokens at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<fernet-key>

# Your Vercel deployment URL (used in CORS allowlist)
VERCEL_URL=https://your-liberty-app.vercel.app
NODE_BACKEND_URL=https://your-liberty-app.vercel.app
