// Liberty Trading Pro — Prisma Schema
// Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────

enum Plan {
  FREE
  CLUB
  PRO
  PORTFOLIO
}

// ─── MODELS ───────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  plan      Plan     @default(FREE)
  active    Boolean  @default(true)
  hotmartId String?
  authId    String?  @unique
  createdAt DateTime @default(now())
  trialEndsAt DateTime?

  tradingPlans   TradingPlan[]
  sessions       TradingSession[]
  weeklyReports  WeeklyReport[]
  monthlyReports MonthlyReport[]
  conversations  VincesConversation[]
  posts          Post[]
  postComments   PostComment[]
}

model TradingPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  broker         String
  accountName    String
  capitalInicial Float
  riesgo         Float
  rrRatio        Float
  riesgoPorTrade Float
  gestionStop    String
  reglas         String
  horaInicio     String
  horaFin        String
  instrumento           String
  dataFeedMensual       Float?
  comisionPorTrade      Float?
  maxDrawdownPermitido  Float?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())

  sessions TradingSession[]
  retiros  Retiro[]
}

model Retiro {
  id       String   @id @default(cuid())
  userId   String
  planId   String?
  plan     TradingPlan? @relation(fields: [planId], references: [id])
  monto    Float
  fecha    DateTime
  nota     String?
  creadoEn DateTime @default(now())
}

model Leccion {
  id            String   @id @default(cuid())
  titulo        String
  descripcion   String
  contenido     String
  videoUrl      String?
  orden         Int      @default(0)
  categoria     String
  publicado     Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  progresos LeccionProgreso[]
}

model LeccionProgreso {
  id        String   @id @default(cuid())
  userId    String
  leccionId String
  creadoEn  DateTime @default(now())
  leccion   Leccion  @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@unique([userId, leccionId])
}

model TradingSession {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  planId         String?
  plan           TradingPlan? @relation(fields: [planId], references: [id])
  date           DateTime
  instrumento    String
  direccion      String
  resultado      String
  pnlBruto       Float
  comisiones     Float        @default(0)
  pnlNeto        Float
  contratos      Int          @default(1)
  entryPrice     Float?
  exitPrice      Float?
  stopLoss       Float?
  takeProfit     Float?
  rrReal         Float?
  siguioPlan     Boolean      @default(true)
  sentimiento    String?
  notas          String?
  screenshotUrl  String?
  vincesAnalysis String?
  createdAt      DateTime     @default(now())
}

model GastoFijo {
  id         String   @id @default(cuid())
  userId     String
  concepto   String
  monto      Float
  frecuencia String
  diaCobro   Int?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model MetricasPeriodo {
  id               String   @id @default(cuid())
  userId           String
  planId           String?
  periodo          String
  totalOperaciones Int
  ganadoras        Int
  perdedoras       Int
  winRate          Float
  winRateLong      Float?
  winRateShort     Float?
  pnlBruto         Float
  comisiones       Float
  pnlNeto          Float
  rendimiento      Float
  profitFactor     Float
  rrPromedio       Float
  maxDrawdown      Float
  maxDrawdownPct   Float
  rachaGanadora    Int
  rachaPerdedora   Int
  pnlPromTrade     Float
  pnlPromGanador   Float
  pnlPromPerdedor  Float
  mejorTrade       Float
  peorTrade        Float
  calculadoAt      DateTime @default(now())
}

model WeeklyReport {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  weekStart       DateTime
  weekEnd         DateTime
  totalTrades     Int
  winRate         Float
  totalPnl        Float
  disciplineScore Float
  patterns        String?
  feedback        String?
  createdAt       DateTime @default(now())
}

model MonthlyReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  month       Int
  year        Int
  metrics     Json
  pdfUrl      String?
  vincesNotes String?
  createdAt   DateTime @default(now())
}

model Opportunity {
  id             String   @id @default(cuid())
  title          String
  ticker         String
  instrumento    String
  tipo           String                   // ACCION | ETF | CRIPTO | FOREX
  direction      String                   // COMPRA | VENTA
  precioEntrada  Float
  precioObjetivo Float
  stopLoss       Float
  timeframe      String                   // CORTO | MEDIANO | LARGO
  riesgo         String                   // BAJO | MEDIO | ALTO
  description    String
  aiReport       String?  @db.Text
  imageUrl       String?
  publishedAt    DateTime @default(now())
  status         String   @default("ACTIVA") // ACTIVA | OBJETIVO_ALCANZADO | STOP_ACTIVADO | CANCELADA
  active         Boolean  @default(true)
  minPlan        Plan     @default(CLUB)
}

model KnowledgeDoc {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  content     String?  @db.Text   // extracted or pasted text for search
  fileUrl     String?             // Cloudinary URL
  fileType    String   @default("text") // text | pdf | image | link
  tags        String?             // comma-separated tags
  source      String?             // author, publication, year
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WhatsappLead {
  id              String   @id @default(cuid())
  phone           String   @unique        // e.g. "593999123456"
  name            String?
  estado          String   @default("NUEVO") // NUEVO | NOMBRE | P1..P5 | CLASIFICADO | CTA | VENDIDO
  perfil          String?                 // APRENDIZ | TRADER
  respuestas      Json?                   // { p1: "...", p2: "...", ... }
  historial       Json?                   // [{ role, content }] últimos 20 msgs
  productoUrl     String?
  followups       Int      @default(0)    // cuántos follow-ups se han enviado
  lastFollowup    DateTime?               // fecha del último follow-up enviado
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VincesConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messages  Json
  context   String?
  sessionId String?
  createdAt DateTime @default(now())
}

model Post {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  tipo        String        // OPERATIVA | TRACK_RECORD | EXITO | RETIRO | ANALISIS
  contenido   String        @db.Text
  imageUrl    String?
  creadoEn    DateTime      @default(now())

  likes       PostLike[]
  comentarios PostComment[]
}

model PostLike {
  id       String   @id @default(cuid())
  userId   String
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  creadoEn DateTime @default(now())

  @@unique([userId, postId])
}

model PostComment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  contenido String
  creadoEn  DateTime @default(now())
}

model VideoSemana {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  youtubeUrl  String
  semana      DateTime // fecha de inicio de la semana que cubre
  publicado   Boolean  @default(true)
  creadoEn    DateTime @default(now())
}
