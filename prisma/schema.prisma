// Liberty Trading Pro — Prisma Schema
// Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────

enum Plan {
  FREE
  CLUB
  PRO
  PORTFOLIO
}

enum NotificationType {
  LIKE
  COMMENT
  SHARE
}

// ─── MODELS ───────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  slug         String?  @unique   // e.g. "luis-riofrio" — URL pública del track record
  phone        String?
  plan         Plan     @default(FREE)
  active       Boolean  @default(true)
  hotmartId    String?
  authId       String?  @unique
  createdAt    DateTime @default(now())
  trialEndsAt  DateTime?
  avatarUrl    String?
  bio          String?
  country      String?
  tradingStyle String?
  tradingSince Int?

  tradingPlans   TradingPlan[]
  sessions       TradingSession[]
  weeklyReports  WeeklyReport[]
  monthlyReports MonthlyReport[]
  conversations  VincesConversation[]
  posts          Post[]
  postComments   PostComment[]
  postShares     PostShare[]
  certificates   Certificate[]
  mt5Account        MT5Account?
  notifications         Notification[]
  notificationsActed    Notification[] @relation("NotifActor")
  vibeMessages          VibeMessage[]
}

model TradingPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  broker         String
  accountName    String
  capitalInicial Float
  riesgo         Float
  rrRatio        Float
  riesgoPorTrade Float
  gestionStop    String
  reglas         String
  horaInicio     String
  horaFin        String
  instrumento           String
  dataFeedMensual       Float?
  comisionPorTrade      Float?
  maxDrawdownPermitido  Float?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())

  sessions TradingSession[]
  retiros  Retiro[]
}

model Retiro {
  id       String   @id @default(cuid())
  userId   String
  planId   String?
  plan     TradingPlan? @relation(fields: [planId], references: [id])
  monto    Float
  fecha    DateTime
  nota     String?
  creadoEn DateTime @default(now())
}

model Leccion {
  id            String   @id @default(cuid())
  titulo        String
  descripcion   String
  contenido     String
  videoUrl      String?
  orden         Int      @default(0)
  categoria     String
  publicado     Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  progresos LeccionProgreso[]
}

model LeccionProgreso {
  id        String   @id @default(cuid())
  userId    String
  leccionId String
  creadoEn  DateTime @default(now())
  leccion   Leccion  @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@unique([userId, leccionId])
}

model TradingSession {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  planId         String?
  plan           TradingPlan? @relation(fields: [planId], references: [id])
  date           DateTime
  instrumento    String
  direccion      String
  resultado      String
  pnlBruto       Float
  comisiones     Float        @default(0)
  pnlNeto        Float
  contratos      Int          @default(1)
  entryPrice     Float?
  exitPrice      Float?
  stopLoss       Float?
  takeProfit     Float?
  rrReal         Float?
  siguioPlan     Boolean      @default(true)
  sentimiento    String?
  notas          String?
  screenshotUrl  String?
  vincesAnalysis String?
  createdAt DateTime @default(now())
}

// ─── SCREENER CACHÉ ───────────────────────────────────────────────────────────

model ScreenerCache {
  id        String   @id @default(cuid())
  type      String   @default("lynch")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── VIDEO POR SECCIÓN (admin) ────────────────────────────────────────────────

model SectionVideo {
  id         String   @id @default(cuid())
  section    String   @unique   // "futuros" | "acciones" | "cfds" | "quant"
  youtubeUrl String
  title      String?
  updatedAt  DateTime @updatedAt
}

model GastoFijo {
  id         String   @id @default(cuid())
  userId     String
  concepto   String
  monto      Float
  frecuencia String
  diaCobro   Int?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model MetricasPeriodo {
  id               String   @id @default(cuid())
  userId           String
  planId           String?
  periodo          String
  totalOperaciones Int
  ganadoras        Int
  perdedoras       Int
  winRate          Float
  winRateLong      Float?
  winRateShort     Float?
  pnlBruto         Float
  comisiones       Float
  pnlNeto          Float
  rendimiento      Float
  profitFactor     Float
  rrPromedio       Float
  maxDrawdown      Float
  maxDrawdownPct   Float
  rachaGanadora    Int
  rachaPerdedora   Int
  pnlPromTrade     Float
  pnlPromGanador   Float
  pnlPromPerdedor  Float
  mejorTrade       Float
  peorTrade        Float
  calculadoAt      DateTime @default(now())
}

model WeeklyReport {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  weekStart       DateTime
  weekEnd         DateTime
  totalTrades     Int
  winRate         Float
  totalPnl        Float
  disciplineScore Float
  patterns        String?
  feedback        String?
  createdAt       DateTime @default(now())
}

model MonthlyReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  month       Int
  year        Int
  metrics     Json
  pdfUrl      String?
  vincesNotes String?
  createdAt   DateTime @default(now())
}

model Opportunity {
  id             String   @id @default(cuid())
  title          String
  ticker         String
  instrumento    String
  tipo           String                   // ACCION | ETF | CRIPTO | FOREX
  direction      String                   // COMPRA | VENTA
  precioEntrada  Float
  precioObjetivo Float
  stopLoss       Float
  timeframe      String                   // CORTO | MEDIANO | LARGO
  riesgo         String                   // BAJO | MEDIO | ALTO
  description    String
  aiReport       String?  @db.Text
  imageUrl       String?
  publishedAt    DateTime @default(now())
  status         String   @default("ACTIVA") // ACTIVA | OBJETIVO_ALCANZADO | STOP_ACTIVADO | CANCELADA
  active         Boolean  @default(true)
  minPlan        Plan     @default(CLUB)
}

model KnowledgeDoc {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  content     String?  @db.Text   // extracted or pasted text for search
  fileUrl     String?             // Cloudinary URL
  fileType    String   @default("text") // text | pdf | image | link
  tags        String?             // comma-separated tags
  source      String?             // author, publication, year
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WhatsappLead {
  id              String   @id @default(cuid())
  phone           String   @unique        // e.g. "593999123456"
  name            String?
  estado          String   @default("NUEVO") // NUEVO | NOMBRE | P1..P5 | CLASIFICADO | CTA | VENDIDO
  perfil          String?                 // APRENDIZ | TRADER
  respuestas      Json?                   // { p1: "...", p2: "...", ... }
  historial       Json?                   // [{ role, content }] últimos 20 msgs
  productoUrl     String?
  followups       Int      @default(0)    // cuántos follow-ups se han enviado
  lastFollowup    DateTime?               // fecha del último follow-up enviado
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VincesConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messages  Json
  context   String?
  sessionId String?
  createdAt DateTime @default(now())
}

model Post {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  tipo        String        // OPERATIVA | TRACK_RECORD | EXITO | RETIRO | ANALISIS
  contenido   String        @db.Text
  imageUrl    String?
  creadoEn    DateTime      @default(now())

  likes         PostLike[]
  comentarios   PostComment[]
  shares        PostShare[]
  notifications Notification[]
}

model PostLike {
  id       String   @id @default(cuid())
  userId   String
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  creadoEn DateTime @default(now())

  @@unique([userId, postId])
}

model PostComment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  contenido String
  creadoEn  DateTime @default(now())
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  category   String   // FONDEO | RETIRO | MERITO | ACADEMICO | DIPLOMA | OTRO
  fileUrl    String
  fileType   String   @default("image") // image | pdf
  issuedBy   String?
  issuedDate String?
  public     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model VideoSemana {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  youtubeUrl  String
  semana      DateTime // fecha de inicio de la semana que cubre
  publicado   Boolean  @default(true)
  creadoEn    DateTime @default(now())
}

// ─── MT5 TRADING AUTOMÁTICO ───────────────────────────────────────────────────

model MT5Account {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaApiAccountId String               // ID de cuenta en MetaAPI.cloud
  accountName      String?              // nombre descriptivo del usuario
  broker           String?              // nombre del broker
  login            String               // número de login MT5 (solo display)
  server           String?              // servidor MT5 del broker
  isConnected      Boolean  @default(false)
  lastSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trades MT5Trade[]
}

model MT5Trade {
  id               String      @id @default(cuid())
  mt5AccountId     String
  mt5Account       MT5Account  @relation(fields: [mt5AccountId], references: [id], onDelete: Cascade)
  symbol           String
  type             String      // BUY | SELL
  volume           Float
  entryPrice       Float?
  sl               Float?
  tp               Float?
  comment          String?     // ej: "Liberty AI — COMPRA BTC 87%"
  metaApiOrderId   String?     // ID de orden en MetaAPI
  status           String      @default("PENDING") // PENDING | OPEN | CLOSED | FAILED
  errorMessage     String?
  openedAt         DateTime?
  closedAt         DateTime?
  pnl              Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ─── NOTIFICACIONES ───────────────────────────────────────────────────────────

model Notification {
  id       String           @id @default(cuid())
  userId   String           // receptor = dueño del post
  actorId  String           // quien disparó el evento
  actor    User             @relation("NotifActor", fields: [actorId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  type     NotificationType
  postId   String
  post     Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  read     Boolean          @default(false)
  creadoEn DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, creadoEn])
}

model PostShare {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform String   // FACEBOOK | WHATSAPP | LINKEDIN | COPY
  creadoEn DateTime @default(now())
}


// ─── VIBE AGENT CHAT HISTORY ─────────────────────────────────────────────────

model VibeMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // user | agent
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── CFD SEÑALES DE TRADING ───────────────────────────────────────────────────

model CfdSignal {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())

  simbolo       String
  nombre        String
  sector        String
  sesgo         String                           // COMPRA | VENTA
  confianza     Int
  razon         String    @db.Text

  precioEntrada Float
  stopLoss      Float
  takeProfit    Float
  lotaje        Float
  riesgoUsd     Float     @default(10)
  rrRatio       Float     @default(2.0)
  riskProfile   String    @default("moderado")

  // Contexto FAROS al momento del análisis
  farosSesgo    String?
  farosRegimen  String?
  psiScore      Float?
  killSwitch    Boolean   @default(false)

  // Forward testing / backtesting
  resultado     String    @default("PENDIENTE") // GANADA|PERDIDA|BREAKEVEN|PENDIENTE
  pnlUsd        Float?
  closedAt      DateTime?
  closedPrice   Float?

  @@index([createdAt])
  @@index([simbolo, createdAt])
  @@index([resultado])
}

// ─── LABORATORIO DE ESTRATEGIA ────────────────────────────────────────────────

// Escaneo automático diario a las 9am ET (lunes a viernes)
model MarketScan {
  id           String   @id @default(cuid())
  fecha        DateTime // fecha del escaneo (día a las 00:00 UTC)
  hora         String   // "09:00 ET"
  sesgogeneral String   // ALCISTA | BAJISTA | NEUTRAL
  resumen      String?  @db.Text
  riskProfile  String   @default("moderado")
  createdAt    DateTime @default(now())

  oportunidades ScanOpportunity[]
}

// Oportunidades detectadas con confianza >= 70% en el escaneo de las 9am
model ScanOpportunity {
  id        String     @id @default(cuid())
  scanId    String
  scan      MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  simbolo   String    // "NQ", "BTC", "SP500", "RUSSELL", etc.
  nombre    String
  sesgo     String    // COMPRA | VENTA (nunca NEUTRAL — filtrado en el cron)
  confianza Int       // >= 70
  precio9am Float     // precio al momento del scan (9am ET)
  razon     String?   @db.Text
  sector    String

  // Cierre 1: 12pm ET (cron automático)
  precio12pm      Float?
  rendimiento12pm Float?  // % a favor del sesgo: positivo = ganó, negativo = perdió

  // Cierre 2: 3pm ET (cron automático)
  precio3pm      Float?
  rendimiento3pm Float?

  // Cierre 3: cambio de sesgo detectado automáticamente (bias-monitor cada 30 min)
  precioSesgoFlip Float?  // precio cuando el sesgo se invirtió
  horaSesgoFlip   String? // hora local del cambio detectado (ej: "11:30 ET")
  rendimientoFlip Float?  // % de movimiento 9am → flip a favor del sesgo original

  createdAt DateTime @default(now())
}
