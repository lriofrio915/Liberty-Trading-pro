{
  "headers": [
    {
      "source": "/api/prices",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=15, stale-while-revalidate=30"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/market-scan",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/futuros-sesgo",
      "schedule": "15 13 * * 1-5"
    },
    {
      "path": "/api/cron/daily-scanner",
      "schedule": "35 13 * * 1-5"
    },
    {
      "path": "/api/cron/morning-agents",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/cron/bias-monitor",
      "schedule": "*/30 13-19 * * 1-5"
    },
    {
      "path": "/api/cron/scan-prices?checkpoint=12pm",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/cron/scan-prices?checkpoint=1445pm",
      "schedule": "45 18 * * 1-5"
    },
    {
      "path": "/api/cron/futuros-open",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/cron/futuros-close",
      "schedule": "45 19 * * 1-5"
    },
    {
      "path": "/api/cron/monitor-signals",
      "schedule": "*/15 13-21 * * 1-5"
    }
  ]
}
