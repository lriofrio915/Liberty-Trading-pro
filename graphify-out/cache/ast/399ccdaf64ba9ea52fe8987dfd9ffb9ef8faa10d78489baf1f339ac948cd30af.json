financials", "callee": "join", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L141"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "encodeURIComponent", "is_member_call": false, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L158"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "encodeURIComponent", "is_member_call": false, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L158"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "fetch", "is_member_call": false, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L159"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "timeout", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L161"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "json", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L168"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "map", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L198"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "slice", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L198"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "toUpperCase", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L214"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "slice", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L219"}, {"caller_nid": "lib_yahoo_financials_fetchtickerfinancials", "callee": "(() => {\n      // Use Yahoo's D/E directly if available (it's already a ratio)\n      const yahooDE = safeNum(keyStats.debtToEquity?.raw)\n      if (yahooDE != null && yahooDE >= 0) return yahooDE\n      \n      // Fallback: Calculate from Enterprise Value\n      const ev = safeNum(keyStats.enterpriseValue?.raw) ?? 0\n      const mktCap = safeNum(price.marketCap?.raw) ?? 0\n      const debt = safeNum(keyStats.totalDebt?.raw) ?? 0\n      const cash = safeNum(finData.totalCash?.raw) ?? 0\n      \n      if (ev > 0 && mktCap > 0) {\n        // Net Debt = EV - Market Cap (approximation of debt - cash)\n        const netDebt = ev - mktCap\n        const equity = mktCap\n        if (equity > 0) return netDebt / equity\n      }\n      \n      // Final fallback: total debt to market cap\n      if (debt > 0 && mktCap > 0) {\n        return debt / mktCap\n      }\n      \n      return null\n    })", "is_member_call": false, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L237"}, {"caller_nid": "lib_yahoo_financials_builddatablock", "callee": "join", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L307"}, {"caller_nid": "lib_yahoo_financials_builddatablock", "callee": "map", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L307"}, {"caller_nid": "lib_yahoo_financials_fetchbatchfinancials", "callee": "slice", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L326"}, {"caller_nid": "lib_yahoo_financials_fetchbatchfinancials", "callee": "allSettled", "is_member_call": true, "source_file": "/var/www/liberty-trading-new/lib/yahoo-financials.ts", "source_location": "L327"}, {"caller_nid": "lib_yahoo_financials_fetchbatchfinancials", "callee": "map", "is_member_